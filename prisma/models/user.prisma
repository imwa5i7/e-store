model User {
  id String @id @default(cuid())

  email    String @unique
  password String

  firstName String
  lastName  String
  phone String?

  role UserRole @default(CUSTOMER)

  isActive Boolean @default(true)

  isEmailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  CUSTOMER
  ADMIN
}
