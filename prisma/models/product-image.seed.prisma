model ProductImage {
  id Int @id @default(autoincrement())

  productId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl String

  altText String?

  isPrimary Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sortOrder])
}
